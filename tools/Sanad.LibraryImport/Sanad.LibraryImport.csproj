<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Sanad.LibraryImport</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\Sanad.Infrastructure\Sanad.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- قراءة مدة MP3/M4A من الوسوم مباشرة بلا الاعتماد على ffmpeg خارجي (خفة + بلا عمليات تحويل) -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- تحليل CSV يتحمّل فواصل واقتباسات داخل الحقول العربية بأمان -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="import-template.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
