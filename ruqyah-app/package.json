{
  "name": "sanad-ruqyah-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "سند — رفيق الرقية الذاتية: خطط، ورد يومي، ختمة. يعمل دون إنترنت ودون حساب.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "check:guardrails": "node scripts/check-guardrails.mjs",
    "preview": "vite preview",
    "export:dev-plans": "esbuild scripts/export-dev-plans.ts --bundle --platform=node --format=esm --alias:@sanad/shared=../packages/shared/src --outfile=node_modules/.tmp/export-dev-plans.mjs && node node_modules/.tmp/export-dev-plans.mjs ../src/Sanad.Infrastructure/Identity/DevSeed/companion-plans.json"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
