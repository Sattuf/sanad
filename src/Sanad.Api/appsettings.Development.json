{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sanad": "Data Source=sanad_dev.db"
  },
  "Otp": {
    "DevelopmentLogCodes": true
  },
  "Captcha": {
    "Enabled": false
  },
  "Storage": {
    "RootPath": "storage-dev"
  },
  "DevSeed": {
    "Enabled": true
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "RateLimiting": {
    "AuthPerMinute": 120
  }
}
