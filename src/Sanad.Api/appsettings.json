{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "Sanad": "",
    "Redis": ""
  },
  "Auth": {
    "Jwt": {
      "Issuer": "sanad",
      "Audience": "sanad-clients",
      "SigningKeyBase64": "",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "NativeClientIds": []
    },
    "Apple": {
      "ClientIds": []
    }
  },
  "Encryption": {
    "FieldKeyBase64": ""
  },
  "Otp": {
    "CodeLifetimeMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxRequestsPerPhonePerHour": 5,
    "DevelopmentLogCodes": false
  },
  "Captcha": {
    "Enabled": true,
    "SiteKey": "",
    "SecretKey": ""
  },
  "Library": {
    "YouTube": {
      "AllowedChannels": []
    }
  },
  "Deployment": {
    "SingleInstance": false
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "storage",
    "MaxDocumentMegabytes": 10,
    "MaxAudioMegabytes": 60,
    "MaxImportedAudioMegabytes": 250
  },
  "MobileApp": {
    "MinVersion": { "Ios": "0.0.0", "Android": "0.0.0" },
    "StoreUrl": { "Ios": "", "Android": "" }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ]
  },
  "Companion": {
    "SupportUrl": ""
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "OtpRequestsPerMinute": 3,
    "OtpVerifyPerMinute": 10,
    "ShareLinksPerHour": 30,
    "UploadsPerHour": 20,
    "ReportsPerHour": 10,
    "KhatmaInvitesPerHour": 30,
    "MessagesPerMinute": 30,
    "PublicPerMinute": 120,
    "MediaPerMinute": 240
  },
  "Policies": {
    "Versions": {
      "TermsOfService": "1.0",
      "PrivacyPolicy": "1.0",
      "SensitiveDataProcessing": "1.0",
      "MarketingCommunication": "1.0"
    }
  },
  "WebPush": {
    "Enabled": false,
    "Subject": "mailto:support@sanad.app"
  },
  "FeatureManagement": {
    "PushNotifications": false,
    "WhatsAppNotifications": false
  },
  "Outbox": {
    "PollIntervalMilliseconds": 2000,
    "BatchSize": 50,
    "MaxAttempts": 10
  }
}
