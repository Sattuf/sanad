<Project>
  <!-- إعدادات مشتركة لكل مشاريع الحل — راجع references/01-solution-architecture.md §1.3 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1707: أسماء الاختبارات تستخدم الشرطة السفلية؛ CA1848/CA1873: LoggerMessage غير لازم في هذا الحجم -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA1716;CA1711;CA1062;CA1031;CA2007;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1862;CA1819;CA1002;CA2227;CA1056;CA1054;CA1055;CA1515;CA1822;CA1852;CA5394;CA2201;CA1032;CA1064;CA1034;CA1724;CA1812;CA1805;CA1720;CA1051;CA2211;CA1725</NoWarn>
  </PropertyGroup>

  <!-- Domain وApplication: التحذيرات أخطاء — راجع §1.3 البند 3 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sanad.Domain' Or '$(MSBuildProjectName)' == 'Sanad.Application'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
