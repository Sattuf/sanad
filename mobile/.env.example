# عنوان الـ API — على جهاز Android حقيقي استخدم عنوان حاسوبك في الشبكة المحلية لا localhost
EXPO_PUBLIC_API_BASE_URL=http://localhost:5080
# موقع سند على الويب (صفحات الشروط والخصوصية)
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:5173
# نطاق صفحة CAPTCHA داخل التطبيق — يجب أن يكون ضمن النطاقات المسموحة في لوحة Turnstile
EXPO_PUBLIC_CAPTCHA_ORIGIN=https://sanad.app

# دخول جوجل الأصلي (يتطلب بناء تطوير، لا يعمل في Expo Go) — راجع docs/adr/0019
# معرّف عميل الويب: هو جمهور رمز الهوية الذي يقبله الخادم (Auth:Google:ClientId أو Auth:Google:NativeClientIds)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# معرّف عميل iOS معكوساً: com.googleusercontent.apps.XXXX — وقت البناء فقط
GOOGLE_IOS_URL_SCHEME=
